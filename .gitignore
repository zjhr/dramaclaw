/awesome-nanobanana-pro/

# Deploy secrets
deploy/compose/windows/novelvideo.env
deploy/compose/windows/users.json

# Claude Code
# settings.json 是本机的 worktree 开关，不是团队约定，和 local 一样不进仓。
.claude/settings.json
.claude/settings.local.json
.claude/skills/**/*-workspace/
*.skill
/scripts/output
node_modules/
/.pnpm-store/
/docs/issues
scripts/incident_drills/.drill.local.env
.obsidian/
.serena
.prototype-ui
# 用 `docs/*` 而非 `docs/`：`docs/` 会把 docs 目录本身排除，git 就不再往里看，
# 下面两条 `!docs/goals/...` 放行规则永远匹配不到（GoalBuddy 看板与 notes 会静默消失）。
docs/*
!docs/goals/
!docs/goals/**
# 放行 goals 看板后跟着进来的本地运行时噪音。注意必须写在上面那两条 negation **之后**：
# `!docs/goals/**` 会把树下一切都重新放行，包括第 4 行本来挡住的 .DS_Store —— git 后匹配者胜，
# 写在 negation 之前等于没写。
docs/goals/**/.goalbuddy-board/
docs/goals/**/.DS_Store

# 验收日志（证据归档在本地/CI 工件，不进 git）
/acceptance-logs/
docs/oss-split/

# 内部过程文档不进公开仓（迁至 dc workspace docs）
docs/changes/
docs/adr/
docs/compliance/
docs/superpowers/

# git worktree 统一目录(主目录永远 main)
/.worktrees/
/frontend/bun.lock

# 风格图墙的图片改由 OSS 提供(后端配 STYLE_GALLERY_ASSET_BASE),不再随仓库
# 发布。scripts/build_style_gallery.py 仍会把产物写到这里，属本地中间物。
/frontend/public/style-gallery/

# OpenZhenZhen 图像提示词画廊的本地生成物，不入库。
/frontend/public/prompt-gallery/

# 本地一键启动脚本(start.sh)的运行产物
/.local-logs/

# 前端本地运行产物(frontend/state 含本地密钥环，不入库)
/frontend/state/

# Frontend vendor directory (local dependencies)
/frontend/vendor/

# Blender 参数化模板的生成物（跑 scripts/blender/build_template.py 生成）
frontend/public/previs-models/
