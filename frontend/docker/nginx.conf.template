# Rendered to /etc/nginx/conf.d/default.conf at container start by the official
# nginx image's envsubst step. Only backend coordinates and validated payment origins are substituted — see
# the Dockerfile filter.

upstream supertale_backend {
    server ${BACKEND_HOST}:${BACKEND_PORT};
    keepalive 32;
}

# Connection-header value for proxied requests: "upgrade" when the client sends an
# Upgrade header (WebSocket, e.g. /api/v1/chat/ws), empty otherwise so plain HTTP
# and SSE keep keepalive. Consumed by the /api/ proxy block below.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

# HTTPS-only hardening, opt-in via the edge scheme. A TLS reverse proxy / ingress
# sets X-Forwarded-Proto=https and these activate; a direct plain-HTTP self-host
# (the open-source default — LAN IP or localhost, no proxy) leaves them empty so
# nginx omits the header. Without this, upgrade-insecure-requests rewrites the SPA's
# same-origin /assets URLs to https on a port that only speaks http, and the page
# never loads (works on localhost, blank on a LAN IP).
map $http_x_forwarded_proto $csp_upgrade {
    https   "; upgrade-insecure-requests";
    default "";
}
map $http_x_forwarded_proto $hsts_value {
    https   "max-age=63072000; includeSubDomains; preload";
    default "";
}

server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log combined;

    # Larger upload window for ingest/audio assets posted through /api.
    client_max_body_size 200m;

    # SPA shell + static assets. CSP must mirror worker/index.ts THEME_SCRIPT_HASH.
    location / {
        try_files $uri $uri/ /index.html;

        # index.html（SPA 外壳）把 CSP 等安全头作为 HTTP 响应头下发。若不显式设
        # Cache-Control，nginx 只给 ETag/Last-Modified，浏览器会启发式缓存 index.html，
        # 发版后仍套用【缓存里的旧 CSP】——例如某媒体来源刚加进白名单之前的版本，导致新
        # 放行的图片/视频被旧策略拦掉，直到用户手动硬性重载才好。no-cache = 每次用 ETag
        # 回源校验（命中即 304，开销很小），新外壳/CSP 在下次导航即刻生效。带内容 hash 的
        # /assets/* 不受影响，仍走下面 1 年 immutable 缓存。
        add_header Cache-Control "no-cache" always;

        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-LvxLzCeWBZ/DC3ejUm4WcZpQNZXYDUz4p/53gA+dzKk='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://novelvideo-assets-chengdu.oss-cn-chengdu.aliyuncs.com https://nfg-web-assets.cdnfg.com https://nfg-web.oss-cn-chengdu.aliyuncs.com; media-src 'self' blob: https://novelvideo-assets-chengdu.oss-cn-chengdu.aliyuncs.com https://nfg-web-assets.cdnfg.com; font-src 'self' data:; connect-src 'self' https://novelvideo-assets-chengdu.oss-cn-chengdu.aliyuncs.com https://nfg-web-assets.cdnfg.com https://nfg-web.cdnfg.com https://dramaclaw-dl.cdnfg.com https://api.github.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${CSP_PAYMENT_FORM_ORIGINS}; object-src 'none'${csp_upgrade}" always;
        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), picture-in-picture=(self), usb=(), xr-spatial-tracking=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    # Vendored 3D director desk v2 (frontend/public/director-desk-v2). It is a separate
    # Vite SPA loaded in a same-origin iframe by the canvas directorDeskNode, so this
    # path must NOT inherit the site-wide X-Frame-Options: DENY / frame-ancestors 'none'
    # above — DENY rejects same-origin framing too, which leaves the node blank in
    # production while still working in local dev (where no security headers are set at
    # all). Two prod-only failure modes live in this block, so it is spelled out:
    #
    #   * frame-ancestors 'self' + X-Frame-Options SAMEORIGIN — the sub-app is framed by
    #     the DramaClaw shell and by nothing else. 'none' / DENY refuse the parent frame
    #     too, which is exactly the "works in dev, blank in prod" bug.
    #   * script-src 'self' — the sub-app's only scripts are its own hashed ./assets/*.js
    #     modules; the root block's sha256 hash pins the main SPA bundle and would block
    #     the director desk's chunks. Deliberately no 'unsafe-inline': that is why the
    #     vendored index.html loads its host bridge as an external module script.
    #   * worker-src 'self' blob: — the model-import worker is created from a
    #     createObjectURL blob, and the geometry/splat workers follow the same route.
    #   * media-src / img-src blob: data: — video export, screenshot capture and the
    #     material thumbnails all round-trip through blob:/data: URLs.
    # Referrer-Policy and X-Content-Type-Options match every other location.
    #
    # `/director-desk-v2` without the trailing slash must redirect: the sub-app is built
    # with `base: './'` (see frontend/vendor/director-desk/vite.config.ts), so its
    # index.html only resolves its own chunks when the document URL ends in the slash.
    # Without this the browser resolves './assets/…' against the parent directory and
    # every chunk 404s while the shell itself loads fine.
    location = /director-desk-v2 {
        return 301 /director-desk-v2/;
    }

    # Hashed bundles: immutable one-year cache, and a missing file must 404 rather than
    # fall through to the SPA fallback (the fallback would hand back the DramaClaw shell
    # HTML with a 200, and the browser would fail on it as a module with no clue why).
    location ^~ /director-desk-v2/assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ^~ /director-desk-v2/ {
        try_files $uri $uri/ /director-desk-v2/index.html;

        # index.html carries the sub-app's CSP. Same reasoning as the root block: no
        # Cache-Control means browsers heuristically cache it, so a policy fix only
        # lands after a manual hard reload.
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ^~ /director-desk-v2/assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }


    # Exact organization-logo path only. The EE backend owns validation and
    # trusted response metadata; malformed paths fall through to /assets/ =404.
    location ~ "^/assets/org-brand/([A-Za-z0-9_-]{1,64})/logo$" {
        if ($args != "") { return 404; }
        limit_except GET HEAD { deny all; }
        proxy_pass http://supertale_backend/api/v1/org-brand/$1/logo;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass_request_headers off;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Location;

        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Long-cache hashed asset bundles emitted by Vite.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # API and static media proxied to the in-cluster backend Service. Same-origin
    # avoids CORS and matches the cookie-auth flow (st_api_key HttpOnly cookie).
    location /api/ {
        proxy_pass http://supertale_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Forward WebSocket upgrades (e.g. /api/v1/chat/ws) while leaving plain HTTP
        # and SSE on keepalive — see the $connection_upgrade map above.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE: never buffer or cache; long timeouts to keep the channel alive.
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location /static/ {
        proxy_pass http://supertale_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering on;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Container-local healthcheck endpoint for k8s probes. Bypasses the SPA
    # fallback so a 200 always indicates nginx is healthy regardless of dist/.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
